[Unit]
Description=Cadre devnet header relay (Solana light client + proof-mode settlement)
After=cadre-node.service

[Service]
User=lode
EnvironmentFile=/etc/lode/services.env
ExecStart=/bin/sh -c 'exec /opt/lode/bin/header-relay --node http://127.0.0.1:10630 --solana $TOKEN_RPC --payer /etc/lode/keys/ops.json run --settle --poll-ms 3000 --parallel $HR_PARALLEL --work /var/lib/lode/header-relay-work.json'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
