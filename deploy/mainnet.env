# Cadre mainnet facts: DRAFT, nothing deployed (docs/MAINNET.md, owner 2026-10-20 "prepare only").
# Public values only. Program keypairs live outside every repo in ~/.config/pearl-sol/keys-mainnet
# (backup ~/.config/pearl-sol/keys-mainnet-backup), generated on the Mac 2026-11-09, never on a box.
# Every value still starting with TBD_ is an owner decision or a purchase (docs/MAINNET.md section 11).
BOX0_IP=TBD_box0
BOX1_IP=TBD_box1
BOX2_IP=TBD_box2
# public names: rpc, api, mcp, explorer, storefront, relayer under MAINNET_DOMAIN, rpc1/rpc2 on boxes 1-2.
# api.cadre.ag is also the wallet's second signed-config source (cadre-extension docs/REMOTE-CONFIG.md).
MAINNET_DOMAIN=cadre.ag
BOX0_MINER_THREADS=2
BOX1_MINER_THREADS=2
BOX2_MINER_THREADS=2
# a keyed provider is required (the public endpoint stalled the devnet relay); the URL carries the key,
# so it lives in ~/.config/pearl-sol/keys-mainnet/solana-rpc-url, never here
SOLANA_RPC=TBD_keyed_rpc_in_keys_dir
# `--features mainnet` ids (token/programs/*/src/lib.rs, services/header-relay/src/settle.rs)
BRIDGE_PROGRAM=DzMPNPJq72CXWeRJA5EwNYedqoi8XSqgJV3DafX2VfnE
STOREFRONT_PROGRAM=4WsdXqPyhr4wWwBDmCWPJZmSfap9KUr9Kro2mYZ5HvrL
RESERVE_PROGRAM=3P2jhm3WEKMJYPXykN8XTtGtH2DEJgjtBB8BDUx7VQzC
LIGHTCLIENT_PROGRAM=7hCpDo5HvqzWmfmpjXVZp7QPsf3osubHF3uMUML8XxvY
# town and mandate have no mainnet build yet (not part of the launch set); add them the same way if wanted
TOWN_PROGRAM=TBD_not_in_launch_set
# the CADRE mint is made by pump.fun create_v2 at launch from a fresh mint keypair (owner: plain or a
# ground "...pump" vanity address)
MINT=TBD_at_launch
X402_NETWORK=solana
HR_PARALLEL=3
REFUND_GRACE_MS=3600000
HR_CONFIRM_POLL_MS=800
HR_SEND_GAP_MS=400
HEADER_RELAY_BOX="1 2"
BOX0_BLOBS='{"max_total_bytes":40000000000,"put_rate_bytes_per_s":200000000,"put_burst_bytes":268435456}'
BOX1_BLOBS='{"max_total_bytes":16000000000,"keep_replay":false}'
BOX2_BLOBS='{"max_total_bytes":16000000000,"keep_replay":false}'
GATEWAY_EXTRA='--max-balance-rows 8192'
# the devnet model (owner decision 11: keep the 1B or register the 8B on a GPU worker)
MODEL_CHECKPOINT=unsloth/Llama-3.2-1B-Instruct
MODEL_REVISION=5a8abab4a5d6f164389b1079fb721cfab8d7126c
# a new chain has no old deposits to skip
RELAYER_DEPOSIT_CURSOR=0
