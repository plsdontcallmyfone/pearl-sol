# Cadre public devnet facts (public values only; keys live in keys/devnet/, never committed).
# Box IPv4s: fill in when the boxes are bought (docs/REBUILD-2026-11.md Phase A). Every script that
# reaches a box refuses to run while a value it needs still starts with TBD_. The IPs are used only
# for ssh, scp, p2p seeds and the DNS records; every public URL is a name under DEVNET_DOMAIN.
BOX0_IP=64.95.12.36
BOX1_IP=64.94.84.44
BOX2_IP=64.95.12.24
# Public hostnames (docs/REBUILD-2026-11.md "Hostnames"): box 0 serves rpc, api, mcp, explorer,
# storefront, relayer and the site (the bare DEVNET_DOMAIN, app. redirects there); boxes 1 and 2
# serve rpc1 and rpc2. The Caddy templates take @DOMAIN@ and @RPC_HOST@ from these.
DEVNET_DOMAIN=devnet.cadre.ag
BOX0_MINER_THREADS=2
BOX1_MINER_THREADS=2
BOX2_MINER_THREADS=2
SOLANA_RPC=https://api.devnet.solana.com
# the town + DMs program on Solana devnet (docs/TOWN-ON-SOLANA.md); every town or DM writer needs it in its
# environment (cadre-api, cadre-swarm, cadre-desktops, cadre-agents, cadre-trading, test-box desk/traders)
TOWN_PROGRAM=DAyyoBkSmyf3guaYpPp8FCAjRUPB5jZ9DCw6pMZCzGnZ
BRIDGE_PROGRAM=3S226LmVvsoA4QrEpwytiuLxREJrQHS7A1UkeDsJGFoN
STOREFRONT_PROGRAM=9XjvGk2xJdByPL6NmUCQg7RdBLyeDjWjikZBnwuWvAKu
RESERVE_PROGRAM=8m1RBPiiscHWpXRDj4NevSFMN68tbgCC8f4hu6N4hVzi
# new id since the 2026-11 rebuild (D4): keys/devnet/lightclient2-keypair.json; the old 47mavKip... is orphaned
LIGHTCLIENT_PROGRAM=9WB5X6XXgVysKVWC58u4VifSWdTbBpGpawUQCQnFAQ36
LIGHTCLIENT_KEYPAIR=lightclient2
HR_PARALLEL=3
REFUND_GRACE_MS=3600000
HR_CONFIRM_POLL_MS=800
HR_SEND_GAP_MS=400
HEADER_RELAY_BOX="1 2"
# box 0 blob store: room for the registered model (about 1.8 GB) plus job data; uploads at up to 200 MB/s.
# 40 GB since 2026-10-22: replay node (keeps segment A while tickets are live + 720 blocks), about 15 GB
# typical and 26 GB worst case at that day's traffic (SPEC 4.5 "Segment data retention")
BOX0_BLOBS='{"max_total_bytes":40000000000,"put_rate_bytes_per_s":200000000,"put_burst_bytes":268435456}'
# boxes 1-2: their miners fetch model matrices on demand (pinned, never pruned), so the default 1 GB store would fill.
# Mining-only nodes since 2026-10-22 (keep_replay false): model + the newest 4096 jobs' A, at most about 18 GB
BOX1_BLOBS='{"max_total_bytes":16000000000,"keep_replay":false}'
BOX2_BLOBS='{"max_total_bytes":16000000000,"keep_replay":false}'
# cadre-gateway extra flags (inference.env GATEWAY_EXTRA): large house balances (ECOSYSTEM M1.5) up to the
# chain's max_balance_rows; 8192 = the devnet storefront's on-chain max_dim (an order's m is bounded by it)
GATEWAY_EXTRA='--max-balance-rows 8192'
# inference base checkpoint (docs/REBUILD-2026-11.md D6): public, ungated; quantized on box 0 by
# tools/cadre/quantize.py (`devnet-deploy.sh venv`, then `checkpoint`)
MODEL_CHECKPOINT=unsloth/Llama-3.2-1B-Instruct
MODEL_REVISION=5a8abab4a5d6f164389b1079fb721cfab8d7126c
# D7: the relayer's Solana deposit cursor on the new chain: the 219 deposits of the old chain (nonces
# 0-218) are not replayed (`devnet-deploy.sh relayer-cursor`, before cadre-relayer first starts)
RELAYER_DEPOSIT_CURSOR=219
