
explorer.@DOMAIN@ {
	import sec
	import rl explorer 300
	encode gzip
	# token metadata URI of the devnet mint (pump.fun create_v2 uri)
	handle /cadre-token.json {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"name":"Cadre","symbol":"CADRE","description":"Cadre public devnet token (Solana devnet). Bridges 1:1 to the Cadre agent chain, where useful proof of work on paid AI jobs produces the blocks.","external_url":"https://explorer.@DOMAIN@"}` 200
	}
	reverse_proxy 127.0.0.1:10670
}

storefront.@DOMAIN@ {
	import sec
	import rl storefront 120
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Headers "content-type, x-payment"
	@pre method OPTIONS
	respond @pre 204
	reverse_proxy 127.0.0.1:10662
}

relayer.@DOMAIN@ {
	import sec
	import rl relayer 120
	@get method GET
	handle @get {
		header Access-Control-Allow-Origin *
		reverse_proxy 127.0.0.1:10660
	}
	respond 405
}

# cadre-api (services/cadre-api, docs/API.md): CORS, caching and rate limits are the app's
api.@DOMAIN@ {
	import sec
	encode gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:10685 {
		flush_interval -1
		transport http {
			read_timeout 310s
		}
	}
}

# Cadre Connect remote MCP (docs/CONNECT.md): the same cadre-api under a short name, so a user can
# paste https://mcp.@DOMAIN@/mcp; OAuth metadata and the consent page follow the Host it came in on
mcp.@DOMAIN@ {
	import sec
	encode gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:10685 {
		flush_interval -1
		transport http {
			read_timeout 310s
		}
	}
}

# Cadre website (~/cadre-web, cadre-web.service on :10710) on the bare domain; serves /install-miner.sh (devnet defaults)
@DOMAIN@ {
	import sec
	encode gzip
	reverse_proxy 127.0.0.1:10710
}

# app.@DOMAIN@ is an alias of the site
app.@DOMAIN@ {
	import sec
	redir https://@DOMAIN@{uri} permanent
}
