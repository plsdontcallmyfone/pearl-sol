
explorer.@IP@.sslip.io {
	import sec
	encode gzip
	# token metadata URI of the devnet mint (pump.fun create_v2 uri)
	handle /cadre-token.json {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"name":"Cadre","symbol":"CADRE","description":"Cadre public devnet token (Solana devnet). Bridges 1:1 to the Cadre agent chain, where useful proof of work on paid AI jobs produces the blocks.","external_url":"https://explorer.@IP@.sslip.io"}` 200
	}
	reverse_proxy 127.0.0.1:10670
}

storefront.@IP@.sslip.io {
	import sec
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Headers "content-type, x-payment"
	@pre method OPTIONS
	respond @pre 204
	reverse_proxy 127.0.0.1:10662
}

relayer.@IP@.sslip.io {
	import sec
	@get method GET
	handle @get {
		header Access-Control-Allow-Origin *
		reverse_proxy 127.0.0.1:10660
	}
	respond 405
}

# cadre-api (services/cadre-api, docs/API.md): CORS, caching and rate limits are the app's
api.@IP@.sslip.io {
	import sec
	encode gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:10685 {
		flush_interval -1
		transport http {
			read_timeout 310s
		}
	}
}

# Cadre website (~/cadre-web, cadre-web.service on :10710); serves /install-miner.sh (devnet defaults)
cadre.@IP@.sslip.io {
	import sec
	encode gzip
	reverse_proxy 127.0.0.1:10710
}
