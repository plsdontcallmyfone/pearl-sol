# cadre-api https front (services/cadre-api/deploy). @HOST@ = cadre-api.<ip-with-dashes>.sslip.io
# Only 443 is open: the ACME TLS-ALPN challenge runs on 443, the HTTP challenge and the
# :80 redirect are off. CORS, caching and rate limits are the app's (it trusts the last
# X-Forwarded-For hop, which caddy sets to the client address).
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

@HOST@ {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:10685 {
		flush_interval -1
		transport http {
			read_timeout 310s
		}
	}
	log {
		output file /var/log/caddy/cadre-api.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
