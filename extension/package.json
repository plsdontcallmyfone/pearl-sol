{
  "name": "pearl-wallet-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "MV3 browser wallet for pearl-sol: Solana (token chain) and our own PoW agent chain",
  "scripts": {
    "build": "tsc --noEmit -p . && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:ui": "node scripts/ui-check.mjs",
    "vectors:job": "node scripts/gen-job-vectors.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "@scure/base": "1.2.6",
    "@scure/bip39": "1.5.4",
    "@wallet-standard/base": "1.1.0",
    "@wallet-standard/features": "1.1.0",
    "@wallet-standard/wallet": "1.1.0",
    "@solana/wallet-standard-features": "1.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/web3.js": "1.98.0",
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "1.48.2",
    "typescript": "5.7.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
